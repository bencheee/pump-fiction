SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Locks the app behind one shared password. Leave it unset locally so the
# browser suite's production server stays reachable; set it on every hosted
# deployment, where a missing value denies all requests.
PF_ACCESS_PASSWORD=
